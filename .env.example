# Frontend env (Vite). Copy to .env for local overrides.

# Base URL the frontend uses to reach the backend API.
# Leave as "/api" in dev — vite.config.ts proxies /api -> BACKEND_URL.
VITE_API_BASE_URL=/api

# Where the Vite dev proxy forwards /api requests (the FastAPI backend).
BACKEND_URL=http://localhost:8000
